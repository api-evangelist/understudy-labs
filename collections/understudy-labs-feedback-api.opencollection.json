{
  "opencollection": "1.0.0",
  "info": {
    "name": "Understudy Desktop Agent Capabilities Feedback API",
    "version": "2.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Feedback",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Record a human judgment for one identified supervisor decision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:{port}/v1/feedback/supervisor",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Record a human judgment for one identified supervisor decision"
        }
      ]
    }
  ],
  "bundled": true
}